# Allow only build/runtime sources. Never send var, tokens or local host keys.
**
!Dockerfile
!.dockerignore
!client/
!client/go.mod
!client/cmd/
!client/cmd/**
!client/internal/
!client/internal/**
!sservcli/
!sservcli/*.py
!server/
