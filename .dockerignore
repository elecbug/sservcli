!server/container_server.py
!tools/
!tools/bundle_windows.py
!examples/
!examples/services.token.json
!examples/services.token.windows.json
!Build.cmd
!Start.cmd
!Stop.cmd
!README.md
**/__pycache__
**/*_test.go
